{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenBKN DSH Runner Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "operation"],
  "properties": {
    "version": { "const": 1 },
    "operation": {
      "enum": ["list_knowledge_networks", "get_knowledge_network_detail"]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "knowledge_network_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
