+    Remove-Item -LiteralPath $_.FullName -Force
+}
+
+# The npm `.cmd` launcher exits while its node web child keeps serving; verify
+# and stop only node children launched from this round's isolated CLI tree.
+if ($prepared.form -eq 'npm') {
+    $cliRoot = Split-Path (Split-Path $prepared.dshCli)
+    Get-CimInstance Win32_Process -Filter "Name='node.exe'" | Where-Object {
+        $_.CommandLine -like ("*" + $cliRoot + "*") -and $_.CommandLine -match ' web( |$)'
+    } | ForEach-Object {
+        Write-Host ("stopping npm web child pid $($_.ProcessId)")
+        Stop-Process -Id $_.ProcessId -Force
+    }
 }
 
